diff --git a/es-core/src/components/VideoNullComponent.cpp b/es-core/src/components/VideoNullComponent.cpp
new file mode 100644
index 0000000..9fdc5fa
--- /dev/null
+++ b/es-core/src/components/VideoNullComponent.cpp
@@ -0,0 +1,71 @@
+// Video backend used when EmulationStation is built without libVLC.
+// Videos are never played; the theme's static image (snapshot) is shown instead.
+#include "components/VideoVlcComponent.h"
+
+VideoVlcComponent::VideoVlcComponent(Window* window, std::string /*subtitles*/) :
+	VideoComponent(window),
+	mMedia(nullptr),
+	mMediaPlayer(nullptr),
+	mContext(nullptr),
+	mMediaParsing(false)
+{
+}
+
+VideoVlcComponent::~VideoVlcComponent()
+{
+}
+
+void VideoVlcComponent::setupVLC(std::string /*subtitles*/)
+{
+}
+
+void VideoVlcComponent::deinit()
+{
+}
+
+void VideoVlcComponent::setResize(float width, float height)
+{
+	mTargetSize = Vector2f(width, height);
+	mTargetIsMax = false;
+	mStaticImage.setResize(width, height);
+	mSize = mStaticImage.getSize();
+	onSizeChanged();
+}
+
+void VideoVlcComponent::setMaxSize(float width, float height)
+{
+	mTargetSize = Vector2f(width, height);
+	mTargetIsMax = true;
+	mStaticImage.setMaxSize(width, height);
+	mSize = mStaticImage.getSize();
+	onSizeChanged();
+}
+
+void VideoVlcComponent::render(const Transform4x4f& parentTrans)
+{
+	if (!isVisible())
+		return;
+
+	VideoComponent::render(parentTrans);
+	Transform4x4f trans = parentTrans * getTransform();
+	GuiComponent::renderChildren(trans);
+
+	// Without a video backend the snapshot is the only thing we can show.
+	mStaticImage.setOpacity(255);
+	mStaticImage.render(parentTrans);
+}
+
+void VideoVlcComponent::startVideo()
+{
+	mIsPlaying = false;
+}
+
+void VideoVlcComponent::stopVideo()
+{
+	mIsPlaying = false;
+	mStartDelayed = false;
+}
+
+void VideoVlcComponent::handleLooping()
+{
+}
