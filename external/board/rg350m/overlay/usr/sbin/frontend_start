#!/bin/sh
# RG350M-SYS: start EmulationStation instead of GMenu2X.
# (Replaces the OpenDingux version of this script.)

/usr/bin/reset

if [ -x /usr/sbin/gsensor ] ; then
	/usr/sbin/gsensor --stop
fi

# Wait until the display is free (e.g. not used by a console session).
while /bin/true; do
	fuser /dev/dri/by-path/platform-13050000.lcd-controller-card >/dev/null
	[ $? -eq 1 ] && break
	read
done

if [ -r /var/tmp/boot_cpu_freq ] ; then
	cat /var/tmp/boot_cpu_freq > /sys/devices/system/cpu/cpu0/cpufreq/scaling_setspeed
fi

if [ -x ~/.autostart ]; then
	exec ~/.autostart
else
	exec /usr/bin/rg350m-frontend
fi
